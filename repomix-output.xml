@tailwind base;
@tailwind components;
@tailwind utilities;

/* ============================================
   DESIGN TOKENS
   ============================================ */
:root {
  --color-bg: #0a0a0b;
  --color-surface: #111113;
  --color-surface-2: #1a1a1d;
  --color-border: rgba(255, 255, 255, 0.08);
  --color-border-hover: rgba(255, 255, 255, 0.16);
  --color-text: #fafafa;
  --color-text-secondary: #a1a1aa;
  /* Dinaikkan dari #71717a agar lolos kontras AA untuk teks kecil. */
  --color-text-tertiary: #8b8b94;
  --color-accent: #3b82f6;
  --color-accent-hover: #2563eb;
  --color-accent-solid: #2563eb;
  --color-accent-solid-hover: #1d4ed8;
  --color-accent-subtle: rgba(59, 130, 246, 0.1);
  --color-accent-border: rgba(59, 130, 246, 0.25);
  --color-accent-2: #7c3aed;
  --color-accent-3: #06b6d4;
  --color-bg-rgb: 10 10 11;
  --color-surface-rgb: 17 17 19;
  --color-surface-2-rgb: 26 26 29;
  --color-accent-rgb: 59 130 246;
  --color-accent-2-rgb: 124 58 237;
  --color-accent-3-rgb: 6 182 212;
  --font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --radius-sm: 6px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --radius-xl: 16px;
  --radius-full: 9999px;
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.4);
  --shadow-lg: 0 8px 30px rgba(0, 0, 0, 0.5);
  --transition-fast: 150ms ease;
  --transition-base: 250ms ease;
}

[data-theme="light"] {
  --color-bg: #fafafa;
  --color-surface: #ffffff;
  --color-surface-2: #f1f1f3;
  --color-border: rgba(0, 0, 0, 0.08);
  --color-border-hover: rgba(0, 0, 0, 0.16);
  --color-text: #18181b;
  --color-text-secondary: #52525b;
  --color-text-tertiary: #6b6b75;
  --color-accent: #2563eb;
  --color-accent-hover: #1d4ed8;
  --color-accent-solid: #2563eb;
  --color-accent-solid-hover: #1d4ed8;
  --color-accent-subtle: rgba(37, 99, 235, 0.08);
  --color-accent-border: rgba(37, 99, 235, 0.2);
  --color-accent-2: #6d28d9;
  --color-accent-3: #0891b2;
  --color-bg-rgb: 250 250 250;
  --color-surface-rgb: 255 255 255;
  --color-surface-2-rgb: 241 241 243;
  --color-accent-rgb: 37 99 235;
  --color-accent-2-rgb: 109 40 217;
  --color-accent-3-rgb: 8 145 178;
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8px 30px rgba(0, 0, 0, 0.1);
}

/* ============================================
   BASE
   ============================================ */
@layer base {
  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
    scrollbar-gutter: stable;
  }

  body {
    margin: 0;
    font-family: var(--font-family);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    color: var(--color-text);
    background: var(--color-bg);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
    transition: background var(--transition-base), color var(--transition-base);
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
    color: inherit;
    background: none;
    border: none;
    cursor: pointer;
  }

  ul,
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  p {
    margin: 0;
    line-height: 1.6;
  }

  strong {
    font-weight: 600;
    color: var(--color-text);
  }

  ::selection {
    background: var(--color-accent);
    color: #fff;
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-bg);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--color-surface-2);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-text-tertiary);
  }
}

/* ============================================
   COMPONENTS
   ============================================ */
@layer components {
  .container {
    width: 100%;
    max-width: 1120px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
  }

  .section {
    padding-block: clamp(4.5rem, 9vw, 7rem);
  }

  .section__header {
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }

  .section__title {
    font-size: clamp(2rem, 4vw, 2.875rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .section__subtitle {
    margin-top: 0.75rem;
    max-width: 42rem;
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
  }

  .chip--accent {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    border-color: var(--color-accent-border);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    border-radius: var(--radius-full);
  }

  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 9999;
    padding: 0.75rem 1.5rem;
    font-weight: 500;
    color: #fff;
    background: var(--color-accent);
    border-radius: var(--radius-md);
    transition: top var(--transition-fast);
  }

  .skip-link:focus {
    top: 1rem;
  }

  .text-gradient {
    background: linear-gradient(
      100deg,
      var(--color-accent) 0%,
      var(--color-accent-2) 52%,
      var(--color-accent-3) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .section-tint {
    background:
      linear-gradient(180deg, rgba(59, 130, 246, 0.04), transparent 45%),
      var(--color-bg);
  }
}

/* ============================================
   UTILITIES
   ============================================ */
@layer utilities {
  .text-balance {
    text-wrap: balance;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
